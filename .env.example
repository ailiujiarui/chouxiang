# Copy this file to .env, then set your DeepSeek key before running start.cmd.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
NAILONG_DEEPSEEK_MODEL=deepseek-chat
# Optional: semicolon-separated roots on Windows. Defaults to the start directory.
NAILONG_PYTHON_REVIEW_ROOTS=
REFACTOR_AGENT_MOCK_LLM=false

# Optional local-only settings.
REFACTOR_AGENT_ADMIN_TOKEN=
REFACTOR_AGENT_ALLOWED_REPOSITORIES=owner/repository
REFACTOR_AGENT_SQLITE_JOURNAL_MODE=auto
REFACTOR_AGENT_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional startup resilience settings (one-click start.cmd).
# REFACTOR_AGENT_STARTUP_TIMEOUT_SECONDS=120
# REFACTOR_AGENT_STARTUP_PORT_FALLBACK=1
# REFACTOR_AGENT_MAX_RESTARTS=3
# REFACTOR_AGENT_WATCHDOG=1

# Optional mirrors used during Docker/Python bootstrap.
PYTHON_BASE_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
